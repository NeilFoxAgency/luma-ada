# Copy this file to .env and replace the placeholders with real values.
# Never commit your populated .env file.

# Required by both online modes.
GOOGLE_API_KEY=your-google-ai-studio-key
MAPS_API_KEY=your-google-maps-key

# Required only by main_online.py. The no-ElevenLabs mode uses system TTS.
ELEVENLABS_API_KEY=your-elevenlabs-key
